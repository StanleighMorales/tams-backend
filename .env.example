# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required. Compose refuses to start without it.
POSTGRES_PASSWORD=

# Optional, defaults shown.
POSTGRES_DB=tams
POSTGRES_USER=tams

# localhost for local work. On the VPS, set the real domain and Caddy issues
# the certificate automatically (deployment-decision.md section 10).
TAMS_DOMAIN=localhost

# Development enables the OpenAPI document at /openapi/v1.json.
ASPNETCORE_ENVIRONMENT=Development

# Required outside Development (docker-compose.dev.yml supplies a throwaway one for local work): JWT signing key, 32+ random characters
# (for example: openssl rand -base64 48). The API refuses to start without it.
JWT_KEY=

# Development only: seeds a first ADMIN on startup when both are set (ignored in Production).
# Compose passes these as Bootstrap__AdminEmail / Bootstrap__AdminPassword.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Browser origins allowed to call the API, comma-separated. Default is the Vite dev server.
# On the VPS put the deployed front end's address here, e.g. https://tams.example.com
CORS_ORIGINS=http://localhost:5173

# Development only: true loads sample rooms, assets, students and demo accounts into an empty database
# (docs/TEST-DATA.md section list). Ignored in Production.
SEED_DEMO=true

# Development only, needs SEED_DEMO=true: adds a larger test set on top (about 50 assets, 28 students and 29 loans in every
# state, events and inventory audits; docs/TEST-DATA.md section 14a). Added once to a database that lacks it, and again after
# the simulator's Reset button. Ignored in Production. Compose passes it to the API as Seed__Scenarios.
SEED_SCENARIOS=false

# Local front-end work only: host port for the API when using docker-compose.dev.yml (default 8080).
# API_PORT=8080

# Production only (docker-compose.prod.yml, docs/DEPLOY.md). Path to the Firebase service-account JSON, kept
# outside the repo with mode 600. Kiosk IP allowlist: set KIOSK_ENFORCE_IP=true and the egress addresses of the
# kiosk and room stations (the pocket router too) in KIOSK_ALLOWED_IPS, comma-separated.
FCM_CREDENTIALS_FILE=
KIOSK_ENFORCE_IP=false
KIOSK_ALLOWED_IPS=

# Backups (docs/RUNBOOK.md). AGE_RECIPIENT is the age PUBLIC key (age-keygen prints it); keep the private key off
# the server. S3_* is the off-site bucket (Cloudflare R2 or Backblaze B2); leave S3_BUCKET empty to keep local copies only.
AGE_RECIPIENT=
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
