{$TAMS_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# reverse_proxy passes WebSocket upgrades straight through, which is what
	# SignalR needs (deployment-decision.md section 6). Caddy v2 needs no extra
	# directive for it, so there is nothing here to get wrong later.
	reverse_proxy api:8080
}
